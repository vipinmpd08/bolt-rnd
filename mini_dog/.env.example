# Copy to .env and fill in. .env is ignored by git, so keys stay on the Pi.

# Which AI Bolt thinks with: groq, grok, claude, or none (offline)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
XAI_API_KEY=
XAI_MODEL=grok-3-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Accurate speech-to-text for your question: groq (Whisper) or vosk (offline only)
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo

# USB headset (Plantronics Blackwire 315.1)
MIC_DEVICE=plughw:CARD=P3151,DEV=0
SPEAKER_DEVICE=plughw:CARD=P3151,DEV=0
VOLUME=0.8
